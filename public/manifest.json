{
  "manifest_version": 3,
  "name": "CP Assistant - Competitive Programming AI Coach",
  "version": "1.0.0",
  "description": "AI mentor providing intuition, problem breakdown, progressive hints, brute force, and optimal solutions across major coding platforms.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CP Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.leetcode.cn/*",
        "*://*.codeforces.com/*",
        "*://*.hackerrank.com/*",
        "*://*.codechef.com/*",
        "*://*.geeksforgeeks.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://*.leetcode.cn/*",
    "*://*.codeforces.com/*",
    "*://*.hackerrank.com/*",
    "*://*.codechef.com/*",
    "*://*.geeksforgeeks.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ]
}
